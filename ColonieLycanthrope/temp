package TD_PERE_NOEL;

public class Nourriture {

    private String nom ;
    private int valeurNutritive ;

    public Nourriture(String nom, int valeurNutritive){

        this.nom = nom ;
        this.valeurNutritive = valeurNutritive;

    }

    public String getNom() {
        return nom;
    }

    public void setNom(String nom) {
        this.nom = nom;
    }

    public int getValeurNutritive() {
        return valeurNutritive;
    }


    public void setValeurNutritive(int valeurNutritive) {
        this.valeurNutritive = valeurNutritive;
    }

     @Override
    public String toString() {
        return "Nourriture [nom=" + nom + ", valeurNutritive=" + valeurNutritive + "]";
    }

}
